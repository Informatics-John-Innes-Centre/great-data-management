[Unit]
Description=Diskover Dashboard Flask Application
After=network.target

[Service]
User=diskover
Group=diskover
WorkingDirectory=/opt/diskover-dashboard
Environment="PATH=/opt/diskover-dashboard/venv/bin"
EnvironmentFile=-/etc/diskover-dashboard.env
ExecStart=/opt/diskover-dashboard/venv/bin/gunicorn -w 2 --timeout 600 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target