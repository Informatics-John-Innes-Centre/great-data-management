# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ── Database (created on first start) ─────────────────────────────────────────
DB_ROOT_PASSWORD=change-me-root
DISKOVER_DB_PASS=change-me

# ── App ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me
# Set to 1 once the app is served over HTTPS (e.g. behind a reverse proxy).
SESSION_COOKIE_SECURE=0
APP_PORT=5000

# ── Your institute folder and data (paths on this host) ──────────────────────
INSTITUTE_PATH=./institute-local
# Monthly Diskover crawl output (runs/YYYY/MM/), read by import_csv.py.
RUNS_PATH=./runs
# Daily Isilon SmartQuotas JSON dumps — only for `--profile isilon`.
ISILON_JSON_PATH=./isilon-json

# ── NBI LDAP (shared by all institutes) ──────────────────────────────────────
# Which groups make someone an admin or allowed to sign in is per institute,
# set in your institute.yaml (access:), not here.
LDAP_HOST=nbi.ac.uk
LDAP_PORT=3268
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=nbi,DC=ac,DC=uk
LDAP_BIND_USER_DN=CN=ldap-service-user,OU=ServiceAccounts,DC=nbi,DC=ac,DC=uk
LDAP_BIND_USER_PASSWORD=change-me
